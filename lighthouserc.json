{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "localhost:4321",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4321/de/",
        "http://localhost:4321/fr/",
        "http://localhost:4321/en/",
        "http://localhost:4321/de/werkzeuge/",
        "http://localhost:4321/de/werkzeuge/iban-pruefer/",
        "http://localhost:4321/fr/outils/verificateur-iban/",
        "http://localhost:4321/en/tools/iban-validator/",
        "http://localhost:4321/de/impressum/",
        "http://localhost:4321/de/datenschutz/",
        "http://localhost:4321/fr/protection-des-donnees/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
