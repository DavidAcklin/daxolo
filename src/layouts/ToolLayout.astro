---
import BaseLayout from './BaseLayout.astro';
import Kachel from '../components/Kachel.astro';
import { localeTags, type Locale } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

/**
 * Rahmen jeder Toolseite (CLAUDE.md 5).
 *
 * Das Tool selbst kommt in den Standard-Slot, der Erklaertext in den Slot
 * `erklaerung`. "Stand · Quelle" und Haftungsausschluss sind Props, damit kein
 * Tool sie vergessen kann, ohne dass es auffaellt.
 */
interface Props {
  title: string;
  description: string;
  /** ISO-Datum (YYYY-MM-DD) der Fachdaten, die einfliessen. */
  stand?: string | undefined;
  /** Amtliche Stelle hinter den Fachdaten. */
  quelle?: { name: string; url: string } | undefined;
  /** Text bei rechtlicher oder finanzieller Wirkung (CLAUDE.md 10). */
  haftungsausschluss?: string | undefined;
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { title, description, stand, quelle, haftungsausschluss, alternates } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const standFormatiert =
  stand === undefined
    ? undefined
    : new Intl.DateTimeFormat(localeTags[locale], {
        dateStyle: 'long',
        timeZone: 'UTC',
      }).format(new Date(`${stand}T00:00:00Z`));
---

<BaseLayout title={title} description={description} alternates={alternates}>
  <article class="werkzeug stapel">
    <header>
      <h1>{title}</h1>
      <p class="einleitung">{description}</p>
    </header>

    {/* Das Tool. Island, laedt bei Bedarf (CLAUDE.md 5). */}
    <slot />

    {
      (standFormatiert !== undefined || quelle !== undefined) && (
        <p class="herkunft">
          {standFormatiert !== undefined && (
            <span>
              {t('tool.stand')}: <time datetime={stand}>{standFormatiert}</time>
            </span>
          )}
          {quelle !== undefined && (
            <span>
              {standFormatiert !== undefined && ' · '}
              {t('tool.source')}:{' '}
              <a href={quelle.url} rel="noopener noreferrer">
                {quelle.name}
              </a>
            </span>
          )}
        </p>
      )
    }

    {
      haftungsausschluss !== undefined && (
        <Kachel titel={t('tool.disclaimer.title')} titelId="haftungsausschluss">
          <p class="klein">{haftungsausschluss}</p>
        </Kachel>
      )
    }

    {
      /* Der Erklaertext liegt in der Collection `erklaerungen`. Fehlt die Datei
         fuer diese Sprache, entfaellt der Abschnitt — statt einer leeren
         Ueberschrift. */
      Astro.slots.has('erklaerung') && (
        <section class="erklaerung" aria-labelledby="erklaerung-titel">
          <h2 id="erklaerung-titel">{t('tool.explanation.title')}</h2>
          <slot name="erklaerung" />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .werkzeug {
    gap: var(--spacing-kachel);
  }

  .werkzeug > header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .werkzeug h1 {
    margin: 0;
  }

  .einleitung {
    margin: 0;
    color: var(--text-sekundaer);
  }

  .herkunft {
    margin: 0;
    color: var(--text-sekundaer);
    font-size: var(--text-klein);
  }

  .klein {
    margin: 0;
    color: var(--text-sekundaer);
    font-size: var(--text-klein);
  }

  .erklaerung {
    border-block-start: 1px solid var(--linie);
    padding-block-start: var(--spacing-kachel);
  }

  .erklaerung :global(h2) {
    font-size: var(--text-gross);
  }

  .erklaerung :global(h3) {
    font-size: var(--text-basis);
    margin-block: var(--spacing-innen) 0.35rem;
  }

  .erklaerung :global(p) {
    margin-block: 0.75rem 0;
    color: var(--text-sekundaer);
  }
</style>
