---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ModusUmschalter from '../components/ModusUmschalter.astro';
import { localeTags, locales, type Locale } from '../i18n/ui';
import {
  getLocaleFromUrl,
  localePath,
  rechtstextPath,
  switchLocalePath,
  useTranslations,
  werkzeugePath,
} from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  /**
   * Pfade der vorhandenen Sprachfassungen. Ohne die Prop wird der Pfad
   * uebersetzt (Sprache und Werkzeug-Segment); mit ihr gilt ausschliesslich,
   * was drinsteht — fuer Seiten mit uebersetzten Slugs.
   */
  alternates?: Partial<Record<Locale, string>> | undefined;
  /**
   * Für Seiten ohne eigene Adresse, etwa die 404-Seiten: Sie werden unter jeder
   * unbekannten URL ausgeliefert. Dann gibt es kein canonical und kein hreflang,
   * und die Sitemap lässt die Seite weg.
   */
  noindex?: boolean | undefined;
}

const { title, description, alternates, noindex = false } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const base = Astro.site ?? new URL('/', Astro.url);

const canonical = new URL(Astro.url.pathname, base);
const alternateUrls = locales
  .map((l) => ({
    tag: localeTags[l],
    pfad: alternates === undefined ? switchLocalePath(Astro.url.pathname, l) : alternates[l],
  }))
  .filter((eintrag): eintrag is { tag: string; pfad: string } => eintrag.pfad !== undefined)
  .map((eintrag) => ({ tag: eintrag.tag, href: new URL(eintrag.pfad, base).href }));
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t('site.name')}</title>
    <meta name="description" content={description} />
    {/* Ohne Icon fragt der Browser /favicon.ico an und protokolliert einen 404. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical.href} />
          {alternateUrls.map((alt) => (
            <link rel="alternate" hreflang={alt.tag} href={alt.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(localePath('de'), base).href} />
        </>
      )
    }

    {/* Schrift der ersten Textzeile vorladen, damit LCP nicht auf sie wartet. */}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    {
      /*
      Farbmodus setzen, bevor gezeichnet wird — sonst blitzt beim Laden der
      helle Modus auf. Inline und synchron, deshalb kein `type="module"`.
      Gespeichert wird in localStorage, nicht in einem Cookie (CLAUDE.md 10).
    */
    }
    <script is:inline>
      try {
        const modus = localStorage.getItem('daxolo-modus');
        if (modus === 'hell' || modus === 'dunkel') {
          document.documentElement.dataset.modus = modus;
        }
      } catch {
        /* localStorage gesperrt: dann entscheidet prefers-color-scheme. */
      }
    </script>

    {
      /* Ohne JavaScript kann der Umschalter nichts umschalten — dann gilt
        prefers-color-scheme, und ein Bedienelement ohne Wirkung bleibt weg.
        `!important`, weil der gescopte Komponentenstil spezifischer ist und
        diese Regel jede Darstellung des Umschalters übersteuern soll. */
    }
    <noscript>
      <style is:inline>
        [data-modus-umschalter] {
          display: none !important;
        }
      </style>
    </noscript>

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a href="#inhalt" class="sr-only focus:not-sr-only">{t('skip.link')}</a>

    <header class="kopf seite">
      <nav aria-label={t('nav.label')}>
        <ul class="navliste">
          <li><a href={localePath(locale)} class="marke">{t('site.name')}</a></li>
          <li><a href={werkzeugePath(locale)}>{t('nav.tools')}</a></li>
        </ul>
      </nav>
      <div class="schalter">
        <ModusUmschalter />
        <LanguageSwitcher alternates={alternates} />
      </div>
    </header>

    <main id="inhalt" class="seite">
      <slot />
    </main>

    <footer class="fuss seite">
      {/* CLAUDE.md 2.1 — das Verkaufsargument steht auf jeder Seite. */}
      <p>{t('footer.privacy')}</p>
      {/* CLAUDE.md 10: Impressum und Datenschutz aus dem Footer jeder Seite. */}
      <nav aria-label={t('footer.legal')}>
        <ul class="rechtliches">
          <li><a href={rechtstextPath('impressum', locale)}>{t('footer.impressum')}</a></li>
          <li><a href={rechtstextPath('datenschutz', locale)}>{t('footer.datenschutz')}</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>

<style>
  .kopf {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-innen);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--spacing-innen);
  }

  .navliste {
    display: flex;
    gap: var(--spacing-innen);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-klein);
  }

  .navliste a {
    text-decoration: none;
  }

  .marke {
    font-weight: 500;
    color: var(--text-primaer);
    text-decoration: none;
  }

  .schalter {
    display: flex;
    gap: var(--spacing-eng);
    align-items: center;
    flex-wrap: wrap;
  }

  .fuss {
    color: var(--text-sekundaer);
    font-size: var(--text-klein);
    border-block-start: 1px solid var(--linie);
    margin-block-start: var(--spacing-kachel);
  }

  .fuss p {
    margin: 0;
  }

  .rechtliches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-innen);
    list-style: none;
    margin: 0;
    margin-block-start: var(--spacing-eng);
    padding: 0;
  }
</style>
