---
import { getEntry } from 'astro:content';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Tool from '../../../tools/iban-pruefer/Tool.astro';
import { useTranslations } from '../../../i18n/utils';
import { alternatePfade, erklaerungHtml } from '../../../lib/werkzeuge';
import { QUELLE, WERKZEUG_ID } from '../../../tools/iban-pruefer/meta';

/** `/en/tools/iban-validator/` */
const werkzeug = await getEntry('tools', WERKZEUG_ID);
if (werkzeug === undefined) throw new Error(`Werkzeug ${WERKZEUG_ID} fehlt in der Collection.`);

const fassung = werkzeug.data.sprachen.en;
if (fassung === undefined) throw new Error(`Werkzeug ${WERKZEUG_ID} hat keine englische Fassung.`);

const t = useTranslations('en');
const erklaerung = await erklaerungHtml(WERKZEUG_ID, 'en');
---

<ToolLayout
  title={fassung.title}
  description={fassung.description}
  alternates={alternatePfade(werkzeug)}
  stand={QUELLE.geprueft_am}
  quelle={{ name: QUELLE.stelle, url: QUELLE.url }}
  haftungsausschluss={werkzeug.data.haftungsausschluss ? t('tool.disclaimer.text') : undefined}
>
  <Tool locale="en" />
  {erklaerung && <Fragment slot="erklaerung" set:html={erklaerung} />}
</ToolLayout>
