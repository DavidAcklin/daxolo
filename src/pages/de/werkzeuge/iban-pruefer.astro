---
import { getEntry } from 'astro:content';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Tool from '../../../tools/iban-pruefer/Tool.astro';
import { useTranslations } from '../../../i18n/utils';
import { alternatePfade, erklaerungHtml } from '../../../lib/werkzeuge';
import { QUELLE, WERKZEUG_ID } from '../../../tools/iban-pruefer/meta';

/**
 * `/de/werkzeuge/iban-pruefer/`
 *
 * Eine Route je Werkzeug und Sprache, mit dem übersetzten Slug im Dateinamen.
 * Kein dynamisches `[slug]`: sonst landet das Skript jedes Werkzeugs im Bundle
 * jeder Werkzeugseite (CLAUDE.md 8).
 */
const werkzeug = await getEntry('tools', WERKZEUG_ID);
if (werkzeug === undefined) throw new Error(`Werkzeug ${WERKZEUG_ID} fehlt in der Collection.`);

const fassung = werkzeug.data.sprachen.de;
if (fassung === undefined) throw new Error(`Werkzeug ${WERKZEUG_ID} hat keine deutsche Fassung.`);

const t = useTranslations('de');
const erklaerung = await erklaerungHtml(WERKZEUG_ID, 'de');
---

<ToolLayout
  title={fassung.title}
  description={fassung.description}
  alternates={alternatePfade(werkzeug)}
  stand={QUELLE.geprueft_am}
  quelle={{ name: QUELLE.stelle, url: QUELLE.url }}
  haftungsausschluss={werkzeug.data.haftungsausschluss ? t('tool.disclaimer.text') : undefined}
>
  <Tool locale="de" />
  {erklaerung && <Fragment slot="erklaerung" set:html={erklaerung} />}
</ToolLayout>
