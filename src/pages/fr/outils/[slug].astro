---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { alternatePfade, erklaerungFuer, werkzeugRouten } from '../../../lib/werkzeuge';

// `/fr/outils/<slug>/` — Segment und Slug sind franzoesisch (CLAUDE.md 4).
export const getStaticPaths = (() => werkzeugRouten('fr')) satisfies GetStaticPaths;

const { werkzeug, fassung } = Astro.props;
const t = useTranslations('fr');

const erklaerung = await erklaerungFuer(werkzeug.id, 'fr');
const Erklaerung = erklaerung === undefined ? undefined : (await render(erklaerung)).Content;
---

<ToolLayout
  title={fassung.title}
  description={fassung.description}
  alternates={alternatePfade(werkzeug)}
  haftungsausschluss={fassung.haftungsausschluss ? t('tool.disclaimer.text') : undefined}
>
  {Erklaerung && <Erklaerung slot="erklaerung" />}
</ToolLayout>
