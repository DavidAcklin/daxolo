---
import { getEntry, render } from 'astro:content';
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Tool from '../../../tools/iban-pruefer/Tool.astro';
import { useTranslations } from '../../../i18n/utils';
import { alternatePfade, erklaerungFuer } from '../../../lib/werkzeuge';
import { QUELLE, WERKZEUG_ID } from '../../../tools/iban-pruefer/meta';

/** `/fr/outils/verificateur-iban/` */
const werkzeug = await getEntry('tools', WERKZEUG_ID);
if (werkzeug === undefined) throw new Error(`Werkzeug ${WERKZEUG_ID} fehlt in der Collection.`);

const fassung = werkzeug.data.sprachen.fr;
if (fassung === undefined)
  throw new Error(`Werkzeug ${WERKZEUG_ID} hat keine franzoesische Fassung.`);

const t = useTranslations('fr');
const erklaerung = await erklaerungFuer(WERKZEUG_ID, 'fr');
const Erklaerung = erklaerung === undefined ? undefined : (await render(erklaerung)).Content;
---

<ToolLayout
  title={fassung.title}
  description={fassung.description}
  alternates={alternatePfade(werkzeug)}
  stand={QUELLE.geprueft_am}
  quelle={{ name: QUELLE.stelle, url: QUELLE.url }}
  haftungsausschluss={werkzeug.data.haftungsausschluss ? t('tool.disclaimer.text') : undefined}
>
  <Tool locale="fr" />
  {Erklaerung && <Erklaerung slot="erklaerung" />}
</ToolLayout>
