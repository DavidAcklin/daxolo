---
import Kachel from './Kachel.astro';
import { segmente } from '../i18n/umbruch';
import { istZahl, zellText, type Zelle } from './tabellenzeilen';

/**
 * Tabelle in einer Kachel (CLAUDE.md 6).
 *
 * Die Tabelle kommt als Ganzes in eine Kachel, Zeilen trennen Haarlinien —
 * niemals eine Kachel je Datenzeile. Zahlenspalten laufen rechtsbündig in
 * Monospace, damit Werte untereinander vergleichbar bleiben (Leitplanke 5).
 *
 * Der Standard-Slot steht über der Tabelle (etwa ein Statusblock), der Slot
 * `fuss` darunter (etwa ein Kopier-Knopf). Beides bleibt in derselben Kachel —
 * eine Verschachtelungsstufe, nicht zwei.
 *
 * Für Zeilen, die ein Skript ersetzt, liegt in der Tabelle ein Zeilenmuster als
 * `<template>`. Es entsteht aus derselben `zelle()` wie die gerenderten Zeilen
 * und trägt Astros Scope-Attribut — geklonte Zeilen sehen deshalb genau so aus.
 * Ersetzen mit `ersetzeZeilen()` aus `tabellenzeilen.ts`.
 */

export interface Spalte {
  name: string;
  /** Zahlenspalte: rechtsbündig, Monospace, gleiche Ziffernbreite. */
  zahl?: boolean;
}

interface Props {
  titel?: string | undefined;
  hinweis?: string | undefined;
  spalten: Spalte[];
  zeilen: Zelle[][];
  /** Erste Spalte als Zeilenkopf (`<th scope="row">`), etwa bei Feld und Wert. */
  zeilenkopf?: boolean | undefined;
  /** Kopfzeile nur für Screenreader, wenn die Zeilenköpfe für sich sprechen. */
  kopfVerbergen?: boolean | undefined;
  /** Name der Tabelle für Screenreader (`<caption>`). */
  beschriftung?: string | undefined;
  /** Id der `<table>`, damit ein Skript Zeilen ersetzen kann. */
  id?: string | undefined;
}

const { titel, hinweis, spalten, zeilen, zeilenkopf, kopfVerbergen, beschriftung, id } =
  Astro.props;

/** Wie eine Zelle gebaut wird — für gerenderte Zeilen und Muster dieselbe Regel. */
const zelle = (inhalt: Zelle, i: number) => {
  const spalteIstZahl = spalten[i]?.zahl === true;
  return {
    Tag: zeilenkopf === true && i === 0 ? ('th' as const) : ('td' as const),
    klassen: { ende: spalteIstZahl, zahl: istZahl(inhalt, spalteIstZahl) },
    text: zellText(inhalt),
  };
};
---

<Kachel titel={titel} hinweis={hinweis}>
  <div class="inhalt">
    <slot />
    <table id={id} class="tabelle" hidden={zeilen.length === 0}>
      {beschriftung !== undefined && <caption class="sr-only">{beschriftung}</caption>}
      <thead class:list={{ 'sr-only': kopfVerbergen }}>
        <tr>
          {
            spalten.map((spalte) => (
              <th scope="col" class:list={{ ende: spalte.zahl }}>
                {spalte.name}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          zeilen.map((zeile) => (
            <tr>
              {spalten.map((_, i) => {
                const { Tag, klassen, text } = zelle(zeile[i] ?? '', i);
                return (
                  <Tag scope={Tag === 'th' ? 'row' : undefined} class:list={klassen}>
                    {segmente(text).map((s) =>
                      s.umbruchfrei ? <span class="umbruchfrei">{s.text}</span> : s.text,
                    )}
                  </Tag>
                );
              })}
            </tr>
          ))
        }
      </tbody>
      <template data-zeilenmuster>
        <tr>
          {
            spalten.map((_, i) => {
              const { Tag, klassen } = zelle('', i);
              return <Tag scope={Tag === 'th' ? 'row' : undefined} class:list={klassen} />;
            })
          }
        </tr>
      </template>
    </table>
    <slot name="fuss" />
  </div>
</Kachel>

<style>
  .inhalt {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-innen);
  }

  .tabelle {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-basis);
  }

  th,
  td {
    padding-block: var(--spacing-eng);
    text-align: start;
    vertical-align: baseline;
  }

  th + th,
  th + td,
  td + td {
    padding-inline-start: var(--spacing-innen);
  }

  thead th {
    font-weight: 500;
    font-size: var(--text-klein);
    color: var(--text-sekundaer);
  }

  th[scope='row'] {
    font-weight: 400;
    font-size: var(--text-klein);
    color: var(--text-sekundaer);
  }

  /* Haarlinie statt Rahmen, zwischen den Zeilen. Über der ersten nur, wenn eine
     sichtbare Kopfzeile darüber steht. */
  tbody tr + tr > *,
  thead:not(.sr-only) + tbody tr:first-child > * {
    border-block-start: 1px solid var(--linie);
  }

  .ende {
    text-align: end;
  }

  .zahl {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
</style>
